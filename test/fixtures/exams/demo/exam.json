      "code_checks": true
    }
  ],
  "placement": { "per_domain": 2, "difficulties": [1, 3], "seconds_per_question": 30 },
  "plan": {
    "default_weeks": 6,
    "daily_minutes": [15, 30],
    "default_daily_minutes": 15,
    "phases": [
      { "id": "learn", "name": "Learn", "share": 0.6 },
      { "id": "test-ready", "name": "Test-ready", "share": 0.4 }
    ]
  }
