{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testwise",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Preview lives on workers.dev. A muscoota.com/testwise route gets added
  // only once Aubrey approves putting Testwise on the site.
  "workers_dev": true,
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testwise",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Model for Socrates. Set the key with: npx wrangler secret put ANTHROPIC_API_KEY
    "TUTOR_MODEL": "claude-opus-5-5",
    // Model that writes fresh practice questions (and blind-solves them).
    // Falls back to TUTOR_MODEL when unset.
    "GENERATOR_MODEL": "claude-opus-5-5",
    // Fresh questions written per UTC day across all learners (each learner: 20).
    "GENERATOR_DAILY_CAP": "200",
    // Exam pack (exams/<id>/) for learners who haven't picked one.
    "DEFAULT_EXAM": "sat"
  },
  "observability": { "enabled": true },
  // Staging: every merge to main deploys here first (testwise-staging on
  // workers.dev, with its own database). The top level above is production,
  // which only updates when Aubrey publishes a release. Wrangler doesn't copy
  // vars or databases into an env, so they're repeated here; a test checks
  // the var names match.
  "env": {
    "staging": {
      "name": "testwise-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "testwise-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TUTOR_MODEL": "claude-opus-5-5",
        "GENERATOR_MODEL": "claude-opus-5-5",
        // Lower than production: staging is for trying changes, not volume.
        "GENERATOR_DAILY_CAP": "50",
        "DEFAULT_EXAM": "sat"
      }
    }
  }
}
